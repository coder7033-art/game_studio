backend-1   | │  ## 4️⃣ Final ClickHouse SELECT statement                                     │
backend-1   | │                                                                              │
backend-1   | │  ```sql                                                                      │
backend-1   | │ /*  Total revenue and total view count per age‑rating + genre  */           │
backend-1   | │  SELECT                                                                      │
backend-1   | │      f.rating                         AS age_rating,                         │
backend-1   | │      c.name                           AS genre,                              │
backend-1   | │      COUNT(DISTINCT r.rental_id)      AS total_views,                        │
backend-1   | │      SUM(p.amount)                    AS total_revenue                       │
backend-1   | │  FROM dev_film               AS f                                            │
backend-1   | │  JOIN dev_film_category      AS fc ON fc.film_id     = f.film_id             │
backend-1   | │  JOIN dev_category           AS c  ON c.category_id  = fc.category_id        │
backend-1   | │  JOIN dev_inventory          AS i  ON i.film_id      = f.film_id             │
backend-1   | │  JOIN dev_rental             AS r  ON r.inventory_id = i.inventory_id        │
backend-1   | │  JOIN dev_payment            AS p  ON p.rental_id    = r.rental_id           │
backend-1   | │  GROUP BY                                                                    │
backend-1   | │      f.rating,                                                               │
backend-1   | │      c.name                                                                  │
backend-1   | │  ORDER BY                                                                    │
backend-1   | │      f.rating,                                                               │
backend-1   | │      c.name;                                                                 │
backend-1   | │  ```                                                                         │
