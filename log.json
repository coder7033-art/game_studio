backend-1   | │                                                                              │
backend-1   | │  ### 3. Aggregation logic                                                    │
backend-1   | │                                                                              │
backend-1   | │  * **Age‑rating** → `dev_film.rating` (aliased `age_rating`)                 │
backend-1   | │  * **Genre** → `dev_category.name` (aliased `genre`)                         │
backend-1   | │  * **Total revenue** → `SUM(dev_payment.amount)` (aliased `total_revenue`)   │
backend-1   | │  * **Total views** → `COUNT(dev_rental.rental_id)` (aliased `total_views`)   │
backend-1   | │                                                                              │
backend-1   | │  Group by both `age_rating` and `genre`.                                     │
backend-1   | │                                                                              │
backend-1   | │  ---                                                                         │
backend-1   | │                                                                              │
backend-1   | │  ### 4. Final SELECT statement                                               │
backend-1   | │                                                                              │
backend-1   | │  #### 4.1. If the payment data lives in a single table `dev_payment`         │
backend-1   | │                                                                              │
backend-1   | │  ```sql                                                                      │
backend-1   | │  SELECT                                                                      │
backend-1   | │      f.rating        AS age_rating,                                          │
backend-1   | │      c.name          AS genre,                                               │
backend-1   | │      SUM(p.amount)   AS total_revenue,                                       │
backend-1   | │      COUNT(r.rental_id) AS total_views                                       │
backend-1   | │  FROM dev_film AS f                                                          │
backend-1   | │  INNER JOIN dev_film_category AS fc                                          │
backend-1   | │          ON f.film_id = fc.film_id                                           │
backend-1   | │  INNER JOIN dev_category AS c                                                │
backend-1   | │          ON fc.category_id = c.category_id                                   │
backend-1   | │  INNER JOIN dev_inventory AS i                                               │
backend-1   | │          ON f.film_id = i.film_id                                            │
backend-1   | │  INNER JOIN dev_rental AS r                                                  │
backend-1   | │          ON i.inventory_id = r.inventory_id                                  │
backend-1   | │  INNER JOIN dev_payment AS p                                                 │
backend-1   | │          ON r.rental_id = p.rental_id                                        │
backend-1   | │  GROUP BY                                                                    │
backend-1   | │      f.rating,                                                               │
backend-1   | │      c.name                                                                  │
backend-1   | │  ORDER BY                                                                    │
backend-1   | │      f.rating,                                                               │
backend-1   | │      c.name;                                                                 │
backend-1   | │  ```                                                                         │
backend-1   | │                                                                              │
